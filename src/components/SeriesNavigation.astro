---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  currentPost: CollectionEntry<'blog'>;
}

const { currentPost } = Astro.props;
const { series } = currentPost.data;

if (!series) return;

const allPosts = await getCollection('blog', ({ data }) => {
  return data.series === series && !data.draft;
});

const seriesPosts = allPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
---

{
  series && seriesPosts.length > 1 && (
    <aside class="mt-16 border border-(--color-border) bg-(--color-surface)/30 p-6">
      <div class="mb-4 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
        Series · {series.replace(/-/g, ' ')}
      </div>
      <ol class="space-y-2">
        {seriesPosts.map((post) => {
          const current = post.id === currentPost.id;
          return (
            <li class="flex gap-3 font-mono text-sm">
              <span class="text-(--color-muted-foreground)">
                {String(post.data.seriesOrder ?? 0).padStart(2, '0')}.
              </span>
              {current ? (
                <span class="text-(--color-primary)">{post.data.title}</span>
              ) : (
                <a
                  href={`/blog/${post.id}`}
                  class="text-(--color-foreground) hover:text-(--color-primary)"
                >
                  {post.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </aside>
  )
}
