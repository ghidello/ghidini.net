---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/collections';

interface Props {
  currentPost: CollectionEntry<'blog'>;
}

const { currentPost } = Astro.props;
const { series } = currentPost.data;

if (!series) return;

const allPosts = await getCollection('blog', ({ data }) => {
  return data.series === series && isPublished(data);
});

const seriesPosts = allPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
---

{
  series && seriesPosts.length > 1 && (
    <aside class="border-border bg-surface/30 mt-16 border p-6">
      <div class="text-primary mb-4 font-mono text-xs tracking-widest uppercase">
        Series · {series.replace(/-/g, ' ')}
      </div>
      <ol class="space-y-2">
        {seriesPosts.map((post) => {
          const current = post.id === currentPost.id;
          return (
            <li class="flex gap-3 font-mono text-sm">
              <span class="text-muted-foreground">
                {String(post.data.seriesOrder ?? 0).padStart(2, '0')}.
              </span>
              {current ? (
                <span class="text-primary">{post.data.title}</span>
              ) : (
                <a href={`/blog/${post.id}`} class="text-foreground hover:text-primary">
                  {post.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </aside>
  )
}
