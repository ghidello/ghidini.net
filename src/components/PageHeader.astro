---
interface Props {
  label: string;
  title: string;
  description: string;
}

const { label, title, description } = Astro.props;
---

<div class="mb-12">
  <div class="mb-4 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
    {label}
  </div>
  <h1 class="mb-4 text-5xl font-extrabold tracking-tight text-(--color-foreground)">{title}</h1>
  <p class="max-w-2xl text-lg text-(--color-muted-foreground)">
    {description}
  </p>
</div>
