---
interface Props {
  label: string;
  title: string;
  description: string;
}

const { label, title, description } = Astro.props;
---

<div class="mb-12">
  <div class="text-primary mb-4 font-mono text-xs tracking-widest uppercase">
    {label}
  </div>
  <h1 class="text-foreground mb-4 text-5xl font-extrabold tracking-tight">{title}</h1>
  <p class="text-muted-foreground max-w-2xl text-lg">
    {description}
  </p>
</div>
