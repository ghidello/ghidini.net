---
import { GISCUS } from '../consts';

// Renders the giscus comments widget (https://giscus.app), backed by GitHub
// Discussions. Configuration lives in `src/consts.ts`.
//
// For GDPR compliance the widget is NOT loaded automatically: embedding the
// giscus iframe contacts giscus.app and github.com (transmitting the visitor's
// IP and potentially setting cookies). Instead we render a placeholder and only
// inject the giscus script after the visitor explicitly clicks to load it,
// which constitutes consent for that third-party processing.
const configured = GISCUS.repoId !== '' && GISCUS.categoryId !== '';
---

{
  configured && (
    <section class="border-border mt-16 border-t pt-12">
      <h2 class="text-muted-foreground mb-6 font-mono text-xs tracking-widest uppercase">
        Comments
      </h2>

      <div id="giscus-placeholder" class="border-border bg-surface rounded border p-6">
        <p class="text-muted-foreground mb-4 text-sm leading-relaxed">
          Comments are powered by{' '}
          <a
            href="https://giscus.app"
            rel="noopener noreferrer"
            target="_blank"
            class="text-accent hover:underline"
          >
            giscus
          </a>{' '}
          and GitHub Discussions. Loading them connects to giscus.app and github.com, which may
          process your IP address and set cookies. See the{' '}
          <a href="/privacy" class="text-accent hover:underline">
            privacy policy
          </a>{' '}
          for details.
        </p>
        <button
          id="giscus-load"
          type="button"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping={GISCUS.mapping}
          data-reactions-enabled={GISCUS.reactionsEnabled}
          data-input-position={GISCUS.inputPosition}
          data-theme={GISCUS.theme}
          data-lang={GISCUS.lang}
          class="border-accent/40 bg-accent/10 text-accent hover:bg-accent/20 cursor-pointer border px-4 py-2 font-mono text-xs tracking-widest uppercase transition-colors"
        >
          Load comments
        </button>
      </div>

      <div class="giscus" />

      <script>import '../scripts/giscus';</script>
    </section>
  )
}
