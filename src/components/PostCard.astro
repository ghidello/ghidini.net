---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagBadge from './TagBadge.astro';
import { getReadingTime } from '../utils/collections';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  showDescription?: boolean;
  showTags?: boolean;
  variant?: 'default' | 'bordered';
}

const {
  post,
  headingLevel = 'h2',
  showDescription = true,
  showTags = true,
  variant = 'default',
} = Astro.props;

const HeadingTag = headingLevel;
const readingTime = getReadingTime(post.body);
const articleClass =
  variant === 'bordered'
    ? 'group border-y border-transparent px-2 py-8 transition-colors hover:border-border hover:bg-surface/30'
    : 'group';
---

<article class={articleClass}>
  <div
    class="text-muted-foreground mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest uppercase"
  >
    <FormattedDate date={post.data.pubDate} />
    <span class="text-primary">&bull;</span>
    <span>{readingTime} min read</span>
    {
      post.data.series && (
        <>
          <span class="text-primary">&bull;</span>
          <span>Series: {post.data.series.replace(/-/g, ' ')}</span>
        </>
      )
    }
  </div>
  <a href={`/blog/${post.id}`} class="block">
    <HeadingTag
      class="text-foreground group-hover:text-primary mb-2 text-2xl font-bold transition-colors"
    >
      {post.data.title}
    </HeadingTag>
  </a>
  {
    showDescription && post.data.description && (
      <p class="text-muted-foreground mb-6 leading-relaxed">{post.data.description}</p>
    )
  }
  {
    showTags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )
  }
</article>
