---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagBadge from './TagBadge.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  showDescription?: boolean;
  showTags?: boolean;
  variant?: 'default' | 'bordered';
}

const {
  post,
  headingLevel = 'h2',
  showDescription = true,
  showTags = true,
  variant = 'default',
} = Astro.props;

const HeadingTag = headingLevel;
const articleClass =
  variant === 'bordered'
    ? 'group border-y border-transparent px-2 py-8 transition-colors hover:border-(--color-border) hover:bg-(--color-surface)/30'
    : 'group';
---

<article class={articleClass}>
  <div
    class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest text-(--color-muted-foreground) uppercase"
  >
    <FormattedDate date={post.data.pubDate} />
    {
      post.data.series && (
        <>
          <span class="text-(--color-primary)">&bull;</span>
          <span>Series: {post.data.series.replace(/-/g, ' ')}</span>
        </>
      )
    }
  </div>
  <a href={`/blog/${post.id}`} class="block">
    <HeadingTag
      class="mb-2 text-2xl font-bold text-(--color-foreground) transition-colors group-hover:text-(--color-primary)"
    >
      {post.data.title}
    </HeadingTag>
  </a>
  {
    showDescription && post.data.description && (
      <p class="mb-6 leading-relaxed text-(--color-muted-foreground)">{post.data.description}</p>
    )
  }
  {
    showTags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )
  }
</article>
