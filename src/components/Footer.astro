---
const year = new Date().getFullYear();
---

<footer class="border-border mt-32 border-t px-6 py-12">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 md:flex-row">
    <div class="text-muted-foreground font-mono text-xs">
      &copy; 1985&ndash;{year} Alessandro Ghidini &middot; Powered by 1.21 Gigawatts
    </div>
    <div class="flex gap-6 font-mono text-[10px] tracking-widest uppercase">
      <a href="/privacy" class="text-muted-foreground hover:text-primary transition-colors">
        Privacy
      </a>
      <a href="/terms" class="text-muted-foreground hover:text-primary transition-colors">
        Terms
      </a>
      <a
        href="https://github.com/ghidello"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://x.com/ghidello"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors"
      >
        X / Twitter
      </a>
      <a
        href="https://www.linkedin.com/in/alessandroghidini/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
