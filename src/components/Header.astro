---
const NAV = [
  { label: 'Blog', href: '/blog' },
  { label: 'Guides', href: '/guides' },
  { label: 'Series', href: '/series' },
  { label: 'Archive', href: '/archive' },
  { label: 'About', href: '/about' },
  { label: 'Search', href: '/search' },
];
const pathname = Astro.url.pathname;
---

<nav class="border-border bg-background/80 sticky top-0 z-50 border-b px-6 py-4 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="group flex items-center gap-3">
      <img
        src="/favicon.svg"
        alt=""
        aria-hidden="true"
        width="32"
        height="32"
        class="logo-pulse size-8"
      />
      <span
        class="text-foreground group-hover:text-primary font-mono text-lg font-bold tracking-tighter italic transition-colors"
      >
        THE FLUX CAPACITOR
      </span>
    </a>
    <div class="hidden gap-5 font-mono text-xs tracking-widest uppercase md:flex lg:gap-8">
      {
        NAV.map((item, idx) => {
          const active = pathname === item.href || pathname.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class={
                active
                  ? 'text-primary'
                  : 'text-muted-foreground hover:text-primary transition-colors'
              }
            >
              [{String(idx + 1).padStart(2, '0')}] {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>

<style>
  /* Gently pulse the flux-capacitor logo with a cyan glow. */
  .logo-pulse {
    animation: logo-glow 2.4s ease-in-out 2 both;
  }
  @keyframes logo-glow {
    0% {
      filter: drop-shadow(0 0 1px color-mix(in oklab, var(--color-primary) 50%, transparent));
      opacity: 0.9;
    }
    50% {
      filter: drop-shadow(0 0 6px var(--color-primary));
      opacity: 1;
    }
    100% {
      filter: drop-shadow(0 0 0 transparent);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-pulse {
      animation: none;
    }
  }
</style>
