---
const NAV = [
  { label: 'Blog', href: '/blog' },
  { label: 'Guides', href: '/guides' },
  { label: 'Series', href: '/series' },
];
const pathname = Astro.url.pathname;
---

<nav
  class="sticky top-0 z-50 border-b border-(--color-border) bg-(--color-background)/80 px-6 py-4 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="group flex items-center gap-3">
      <div
        class="flex size-8 items-center justify-center rounded border border-(--color-primary)/40 bg-(--color-primary)/10"
      >
        <div class="size-2 animate-pulse rounded-full bg-(--color-primary)"></div>
      </div>
      <span
        class="font-mono text-lg font-bold tracking-tighter text-(--color-foreground) italic transition-colors group-hover:text-(--color-primary)"
      >
        THE FLUX CAPACITOR
      </span>
    </a>
    <div class="hidden gap-8 font-mono text-xs tracking-widest uppercase md:flex">
      {
        NAV.map((item, idx) => {
          const active = pathname === item.href || pathname.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class={
                active
                  ? 'text-(--color-primary)'
                  : 'text-(--color-muted-foreground) transition-colors hover:text-(--color-primary)'
              }
            >
              [{String(idx + 1).padStart(2, '0')}] {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
