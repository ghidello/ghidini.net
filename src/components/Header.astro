---
const NAV = [
  { label: 'Blog', href: '/blog' },
  { label: 'Guides', href: '/guides' },
  { label: 'Series', href: '/series' },
  { label: 'Archive', href: '/archive' },
  { label: 'About', href: '/about' },
  { label: 'Search', href: '/search' },
];
const pathname = Astro.url.pathname;
---

<nav class="border-border bg-background/80 sticky top-0 z-50 border-b px-6 py-4 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="group flex items-center gap-3">
      <div
        class="border-primary/40 bg-primary/10 flex size-8 items-center justify-center rounded border"
      >
        <div class="bg-primary size-2 animate-pulse rounded-full"></div>
      </div>
      <span
        class="text-foreground group-hover:text-primary font-mono text-lg font-bold tracking-tighter italic transition-colors"
      >
        THE FLUX CAPACITOR
      </span>
    </a>
    <div class="hidden gap-5 font-mono text-xs tracking-widest uppercase md:flex lg:gap-8">
      {
        NAV.map((item, idx) => {
          const active = pathname === item.href || pathname.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class={
                active
                  ? 'text-primary'
                  : 'text-muted-foreground hover:text-primary transition-colors'
              }
            >
              [{String(idx + 1).padStart(2, '0')}] {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
