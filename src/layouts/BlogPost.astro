---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="prose">
    {heroImage && <img src={heroImage} alt={title} class="mb-8 w-full rounded-lg" />}

    <header class="mb-8">
      <h1 class="mb-2 text-3xl font-bold text-(--color-text) sm:text-4xl">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-(--color-text-secondary)">
        <FormattedDate date={pubDate} format="long" />
        {
          updatedDate && (
            <span>
              (Updated: <FormattedDate date={updatedDate} format="long" />)
            </span>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full border border-(--color-border) bg-(--color-bg-secondary) px-2 py-1 text-xs text-(--color-text-secondary)">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <SeriesNavigation currentPost={post} />

    <div class="prose-content">
      <slot />
    </div>

    <SeriesNavigation currentPost={post} />
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .prose-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .prose-content :global(code) {
    background-color: var(--color-code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .prose-content :global(pre) {
    background-color: var(--color-code-bg);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose-content :global(li) {
    margin-bottom: 0.25rem;
    line-height: 1.75;
  }

  .prose-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .prose-content :global(img) {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .prose-content :global(hr) {
    border-color: var(--color-border);
    margin: 2rem 0;
  }
</style>
