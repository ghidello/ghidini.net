---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, tags, series, seriesOrder } =
  post.data;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-4xl">
    <a
      href="/blog"
      class="text-muted-foreground hover:text-primary mb-8 inline-block font-mono text-xs tracking-widest uppercase"
    >
      &larr; All posts
    </a>

    <header class="border-border mb-12 border-b pb-8">
      {
        series && (
          <div class="border-accent/30 bg-accent/5 text-accent mb-4 inline-block border px-3 py-1 font-mono text-[10px] tracking-widest uppercase">
            Series: {series.replace(/-/g, ' ')}
            {seriesOrder ? ` · Part ${seriesOrder}` : ''}
          </div>
        )
      }
      <h1
        class="text-foreground mb-4 text-4xl leading-tight font-extrabold tracking-tight md:text-5xl"
      >
        {title}
      </h1>
      <p class="text-muted-foreground mb-6 text-lg">{description}</p>
      <div class="text-muted-foreground flex flex-wrap items-center gap-4 font-mono text-xs">
        <FormattedDate date={pubDate} format="long" />
        <span>· By {author}</span>
        {
          updatedDate && (
            <span>
              · Updated <FormattedDate date={updatedDate} format="long" />
            </span>
          )
        }
        {tags.map((t) => <span class="bg-surface ring-border px-2 py-0.5 ring-1">#{t}</span>)}
      </div>
    </header>

    <div class="prose-flux">
      <slot />
    </div>

    <SeriesNavigation currentPost={post} />

    <Giscus />
  </article>
</BaseLayout>
