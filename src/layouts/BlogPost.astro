---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Giscus from '../components/Giscus.astro';
import { getReadingTime, getRelatedPosts } from '../utils/collections';
import { SITE_TITLE, SITE_URL, AUTHOR } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  author,
  tags,
  series,
  seriesOrder,
} = post.data;

const readingTime = getReadingTime(post.body);
const relatedPosts = await getRelatedPosts(post);
const ogImage = `/open-graph/blog/${post.id}.png`;

const canonical = new URL(`/blog/${post.id}`, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: author, url: AUTHOR.url },
  publisher: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  keywords: tags.join(', '),
  image: new URL(ogImage, SITE_URL).href,
  isPartOf: { '@type': 'Blog', name: SITE_TITLE, url: new URL('/blog', SITE_URL).href },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-4xl" data-pagefind-body>
    <a
      href="/blog"
      class="text-muted-foreground hover:text-primary mb-8 inline-block font-mono text-xs tracking-widest uppercase"
    >
      &larr; All posts
    </a>

    <header class="border-border mb-12 border-b pb-8">
      {
        series && (
          <div class="border-accent/30 bg-accent/5 text-accent mb-4 inline-block border px-3 py-1 font-mono text-[10px] tracking-widest uppercase">
            Series: {series.replace(/-/g, ' ')}
            {seriesOrder ? ` · Part ${seriesOrder}` : ''}
          </div>
        )
      }
      <h1
        class="text-foreground mb-4 text-4xl leading-tight font-extrabold tracking-tight md:text-5xl"
      >
        {title}
      </h1>
      <p class="text-muted-foreground mb-6 text-lg">{description}</p>
      <div class="text-muted-foreground flex flex-wrap items-center gap-4 font-mono text-xs">
        <FormattedDate date={pubDate} format="long" />
        <span>· By {author}</span>
        <span>· {readingTime} min read</span>
        {
          updatedDate && (
            <span>
              · Updated <FormattedDate date={updatedDate} format="long" />
            </span>
          )
        }
        {tags.map((t) => <span class="bg-surface ring-border px-2 py-0.5 ring-1">#{t}</span>)}
      </div>
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="border-border mb-12 w-full border"
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
          loading="eager"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose-flux">
      <slot />
    </div>

    <RelatedPosts posts={relatedPosts} />

    <SeriesNavigation currentPost={post} />

    <Giscus />
  </article>
  <CodeCopy />
</BaseLayout>
