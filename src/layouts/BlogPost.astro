---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, tags, series, seriesOrder } =
  post.data;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-4xl">
    <a
      href="/blog"
      class="mb-8 inline-block font-mono text-xs tracking-widest text-(--color-muted-foreground) uppercase hover:text-(--color-primary)"
    >
      &larr; All posts
    </a>

    <header class="mb-12 border-b border-(--color-border) pb-8">
      {
        series && (
          <div class="mb-4 inline-block border border-(--color-accent)/30 bg-(--color-accent)/5 px-3 py-1 font-mono text-[10px] tracking-widest text-(--color-accent) uppercase">
            Series: {series.replace(/-/g, ' ')}
            {seriesOrder ? ` · Part ${seriesOrder}` : ''}
          </div>
        )
      }
      <h1
        class="mb-4 text-4xl leading-tight font-extrabold tracking-tight text-(--color-foreground) md:text-5xl"
      >
        {title}
      </h1>
      <p class="mb-6 text-lg text-(--color-muted-foreground)">{description}</p>
      <div
        class="flex flex-wrap items-center gap-4 font-mono text-xs text-(--color-muted-foreground)"
      >
        <FormattedDate date={pubDate} format="long" />
        <span>· By {author}</span>
        {
          updatedDate && (
            <span>
              · Updated <FormattedDate date={updatedDate} format="long" />
            </span>
          )
        }
        {
          tags.map((t) => (
            <span class="bg-(--color-surface) px-2 py-0.5 ring-1 ring-(--color-border)">#{t}</span>
          ))
        }
      </div>
    </header>

    <div class="prose-flux">
      <slot />
    </div>

    <SeriesNavigation currentPost={post} />

    <Giscus />
  </article>
</BaseLayout>
