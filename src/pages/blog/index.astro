---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog - The Flux Capacitor" description="All blog posts">
  <h1 class="text-3xl font-bold mb-8">All Posts</h1>
  
  {posts.length === 0 ? (
    <p class="text-(--color-text-secondary)">No posts yet. Check back soon!</p>
  ) : (
    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block p-4 -mx-4 rounded-lg hover:bg-(--color-bg-secondary) transition-colors">
            <h2 class="text-xl font-semibold group-hover:text-(--color-accent) transition-colors">
              {post.data.title}
            </h2>
            <p class="text-(--color-text-secondary) mt-1">{post.data.description}</p>
            <div class="flex flex-wrap items-center gap-3 mt-2 text-sm text-(--color-text-secondary)">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              {post.data.series && (
                <span class="px-2 py-0.5 rounded-full bg-(--color-accent)/10 text-(--color-accent) text-xs">
                  Series: {post.data.series.replace(/-/g, ' ')}
                </span>
              )}
              {post.data.tags.length > 0 && (
                <div class="flex gap-1">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs text-(--color-text-secondary)">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
