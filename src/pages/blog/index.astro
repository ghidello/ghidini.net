---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { getSortedBlogPosts } from '../../utils/collections';

const posts = await getSortedBlogPosts();
---

<BaseLayout title={`Blog - ${SITE_TITLE}`} description="All blog posts">
  <PageHeader
    label="// INDEX_TRANSMISSIONS"
    title="Blog"
    description="Findings, post-mortems, and things I want to be able to grep three years from now."
  />

  {
    posts.length === 0 ? (
      <p class="text-(--color-muted-foreground)">No posts yet. Check back soon!</p>
    ) : (
      <div class="divide-y divide-(--color-border)/0">
        {posts.map((post) => (
          <PostCard post={post} variant="bordered" />
        ))}
      </div>
    )
  }
</BaseLayout>
