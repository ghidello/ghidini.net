---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Blog - ${SITE_TITLE}`} description="All blog posts">
  <h1 class="mb-8 text-3xl font-bold">All Posts</h1>

  {
    posts.length === 0 ? (
      <p class="text-(--color-text-secondary)">No posts yet. Check back soon!</p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group -mx-4 block rounded-lg p-4 transition-colors hover:bg-(--color-bg-secondary)"
            >
              <h2 class="text-xl font-semibold transition-colors group-hover:text-(--color-accent)">
                {post.data.title}
              </h2>
              <p class="mt-1 text-(--color-text-secondary)">{post.data.description}</p>
              <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-(--color-text-secondary)">
                <FormattedDate date={post.data.pubDate} />
                {post.data.series && (
                  <span class="rounded-full bg-(--color-accent)/10 px-2 py-0.5 text-xs text-(--color-accent)">
                    Series: {post.data.series.replace(/-/g, ' ')}
                  </span>
                )}
                {post.data.tags.length > 0 && (
                  <div class="flex gap-1">
                    {post.data.tags.map((tag) => (
                      <span class="text-xs text-(--color-text-secondary)">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
