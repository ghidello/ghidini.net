---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Page Not Found - ${SITE_TITLE}`} description="Page not found">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="mb-4 text-6xl font-bold text-(--color-accent)">404</h1>
    <p class="mb-8 text-xl text-(--color-text-secondary)">Great Scott! This page doesn't exist.</p>
    <a
      href="/"
      class="rounded-lg bg-(--color-accent) px-6 py-3 font-medium text-white transition-opacity hover:opacity-90"
    >
      Back to the future &rarr;
    </a>
  </div>
</BaseLayout>
