---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="The Flux Capacitor - Software Development Blog">
  <section class="mb-12">
    <h1 class="mb-4 text-4xl font-bold">Hey, I'm Alessandro 👋</h1>
    <p class="text-lg leading-relaxed text-(--color-text-secondary)">
      Software developer with a terrible memory. This blog is my external brain — a place where I
      document findings, write guides, and share what I learn so I can find it again later. Maybe
      it'll help you too.
    </p>
    <blockquote
      class="mt-6 border-l-3 border-(--color-accent) pl-4 text-(--color-text-secondary) italic"
    >
      "Roads? Where we're going, we don't need roads."
      <span class="mt-1 block text-sm not-italic">— Doc Brown, Back to the Future</span>
    </blockquote>
  </section>

  <section>
    <h2 class="mb-6 text-2xl font-bold">Latest Posts</h2>
    {
      posts.length === 0 ? (
        <p class="text-(--color-text-secondary)">No posts yet. Check back soon!</p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group -mx-4 block rounded-lg p-4 transition-colors hover:bg-(--color-bg-secondary)"
              >
                <h3 class="text-xl font-semibold transition-colors group-hover:text-(--color-accent)">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-(--color-text-secondary)">{post.data.description}</p>
                <div class="mt-2 flex items-center gap-3 text-sm text-(--color-text-secondary)">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  {post.data.series && (
                    <span class="rounded-full bg-(--color-accent)/10 px-2 py-0.5 text-xs text-(--color-accent)">
                      Series: {post.data.series.replace(/-/g, ' ')}
                    </span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
