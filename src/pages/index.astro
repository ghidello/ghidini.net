---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group series
const seriesMap = new Map<string, { title: string; count: number }>();
for (const post of posts) {
  if (post.data.series) {
    const s = post.data.series;
    if (!seriesMap.has(s)) {
      seriesMap.set(s, { title: s.replace(/-/g, ' '), count: 0 });
    }
    seriesMap.get(s)!.count++;
  }
}
const series = [...seriesMap.entries()];
---

<BaseLayout title={`${SITE_TITLE} — Software Development Blog`}>
  <!-- Hero -->
  <header class="mb-20">
    <div
      class="mb-6 inline-block border border-(--color-accent)/30 bg-(--color-accent)/5 px-3 py-1 font-mono text-[10px] tracking-widest text-(--color-accent) uppercase"
    >
      Status: Externalizing Consciousness
    </div>
    <h1
      class="mb-6 text-5xl leading-none font-extrabold tracking-tight text-(--color-foreground) md:text-7xl"
    >
      Alessandro Ghidini
    </h1>
    <p class="mb-8 max-w-2xl text-xl leading-relaxed text-(--color-muted-foreground)">
      A software developer with a terrible memory &mdash; this blog is my external brain. Technical
      deep-dives on <span class="text-(--color-foreground)">Astro</span>,{' '}
      <span class="text-(--color-foreground)">Cloudflare Workers</span>, and why I forgot that one{
        ' '
      }
      <span class="text-(--color-foreground) italic underline decoration-(--color-primary)"
        >git</span
      > command again.
    </p>

    <blockquote
      class="border-l-2 border-(--color-primary)/30 bg-(--color-primary)/5 p-6 font-mono text-(--color-muted-foreground) italic"
    >
      &ldquo;Roads? Where we&apos;re going, we don&apos;t need roads&hellip; but we definitely need
      better documentation.&rdquo;
      <span class="mt-2 block text-right text-xs not-italic opacity-60">
        &mdash; Dr. Emmett Brown (slightly modified)
      </span>
    </blockquote>
  </header>

  <!-- Content grid -->
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
    <!-- Latest posts -->
    <section class="lg:col-span-8">
      <div class="mb-8 flex items-center justify-between border-b border-(--color-border) pb-4">
        <h2 class="font-mono text-sm font-bold tracking-widest text-(--color-foreground) uppercase">
          Latest Transmissions
        </h2>
        <a href="/blog" class="font-mono text-xs text-(--color-primary) hover:underline">
          View All Index &rarr;
        </a>
      </div>

      {
        posts.length === 0 ? (
          <p class="text-(--color-muted-foreground)">No posts yet. Check back soon!</p>
        ) : (
          <div class="space-y-12">
            {posts.map((post) => (
              <article class="group">
                <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest text-(--color-muted-foreground) uppercase">
                  <FormattedDate date={post.data.pubDate} />
                  {post.data.series && (
                    <>
                      <span class="text-(--color-primary)">&bull;</span>
                      <span>Series: {post.data.series.replace(/-/g, ' ')}</span>
                    </>
                  )}
                </div>
                <a href={`/blog/${post.id}`} class="block">
                  <h3 class="mb-4 text-2xl font-bold text-(--color-foreground) transition-colors group-hover:text-(--color-primary) md:text-3xl">
                    {post.data.title}
                  </h3>
                </a>
                <p class="mb-6 leading-relaxed text-(--color-muted-foreground)">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="border border-(--color-border) bg-(--color-surface) px-2 py-1 font-mono text-[10px] text-(--color-muted-foreground)">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        )
      }
    </section>

    <!-- Sidebar -->
    <aside class="space-y-8 lg:col-span-4">
      <section class="border border-(--color-border) bg-(--color-surface)/30 p-6">
        <h2
          class="mb-6 font-mono text-xs font-bold tracking-widest text-(--color-foreground) uppercase"
        >
          Active Series
        </h2>
        <div class="space-y-4">
          {
            series.length === 0 ? (
              <p class="font-mono text-xs text-(--color-muted-foreground)">No series yet.</p>
            ) : (
              series.map(([id, s]) => (
                <a href="/series" class="group block">
                  <div class="mb-1 font-mono text-xs tracking-widest text-(--color-accent) uppercase">
                    {String(s.count).padStart(2, '0')} parts
                  </div>
                  <div class="font-bold text-(--color-foreground) capitalize transition-colors group-hover:text-(--color-primary)">
                    {s.title}
                  </div>
                </a>
              ))
            )
          }
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
