---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE } from '../consts';
import { getSortedBlogPosts } from '../utils/collections';

const posts = await getSortedBlogPosts();

// Group series
const seriesMap = new Map<string, { title: string; count: number }>();
for (const post of posts) {
  if (post.data.series) {
    const s = post.data.series;
    if (!seriesMap.has(s)) {
      seriesMap.set(s, { title: s.replace(/-/g, ' '), count: 0 });
    }
    seriesMap.get(s)!.count++;
  }
}
const series = [...seriesMap.entries()];

// Collect unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title={`${SITE_TITLE} — Software Development Blog`}>
  <!-- Hero -->
  <header class="mb-20">
    <div
      class="border-accent/30 bg-accent/5 text-accent mb-6 inline-block border px-3 py-1 font-mono text-[10px] tracking-widest uppercase"
    >
      Status: Externalizing Consciousness
    </div>
    <h1
      class="text-foreground mb-6 text-5xl leading-none font-extrabold tracking-tight md:text-7xl"
    >
      Alessandro Ghidini
    </h1>
    <p class="text-muted-foreground mb-8 text-xl leading-relaxed">
      A software developer with a terrible memory &mdash; this blog is my external brain. Technical
      deep-dives on <span class="text-foreground">Astro</span>,{' '}
      <span class="text-foreground">Cloudflare Workers</span>, and why I forgot that one{' '}
      <span class="text-foreground decoration-primary italic underline">git</span> command again.
    </p>

    <blockquote
      class="border-primary/30 bg-primary/5 text-muted-foreground border-l-2 p-6 font-mono italic"
    >
      &ldquo;Roads? Where we&apos;re going, we don&apos;t need roads&hellip; but we definitely need
      better documentation.&rdquo;
      <span class="mt-2 block text-right text-xs not-italic opacity-60">
        &mdash; Dr. Emmett Brown (slightly modified)
      </span>
    </blockquote>
  </header>

  <!-- Content grid -->
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
    <!-- Latest posts -->
    <section class="lg:col-span-8">
      <div class="border-border mb-8 flex items-center justify-between border-b pb-4">
        <h2 class="text-foreground font-mono text-sm font-bold tracking-widest uppercase">
          Latest Transmissions
        </h2>
        <a href="/blog" class="text-primary font-mono text-xs hover:underline">
          View All Index &rarr;
        </a>
      </div>

      {
        posts.length === 0 ? (
          <p class="text-muted-foreground">No posts yet. Check back soon!</p>
        ) : (
          <div class="space-y-12">
            {posts.map((post) => (
              <PostCard post={post} headingLevel="h3" />
            ))}
          </div>
        )
      }
    </section>

    <!-- Sidebar -->
    <aside class="space-y-8 lg:col-span-4">
      <section class="border-border bg-surface/30 border p-6">
        <h2 class="text-foreground mb-6 font-mono text-xs font-bold tracking-widest uppercase">
          Active Series
        </h2>
        <div class="space-y-4">
          {
            series.length === 0 ? (
              <p class="text-muted-foreground font-mono text-xs">No series yet.</p>
            ) : (
              series.map(([id, s]) => (
                <a href={`/series/${id}`} class="group block">
                  <div class="text-accent mb-1 font-mono text-xs tracking-widest uppercase">
                    {String(s.count).padStart(2, '0')} parts
                  </div>
                  <div class="text-foreground group-hover:text-primary font-bold capitalize transition-colors">
                    {s.title}
                  </div>
                </a>
              ))
            )
          }
        </div>
      </section>

      <section class="border-border bg-surface/30 border p-6">
        <h2 class="text-foreground mb-6 font-mono text-xs font-bold tracking-widest uppercase">
          Stack Reference
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            allTags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="border-border bg-surface text-muted-foreground hover:border-primary hover:text-primary border px-2 py-1 font-mono text-[10px] tracking-widest uppercase transition-colors"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </section>

      <section class="border-border bg-surface/30 border p-6">
        <h2 class="text-foreground mb-4 font-mono text-xs font-bold tracking-widest uppercase">
          About this site
        </h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Notes from an engineer's lab notebook. Mostly for me, possibly useful to you. Built on
          Astro. Powered by 1.21 gigawatts.
        </p>
      </section>
    </aside>
  </div>
</BaseLayout>
