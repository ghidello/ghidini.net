---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagBadge from '../../components/TagBadge.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

  const seriesMap = new Map<string, typeof posts>();
  for (const post of posts) {
    const series = post.data.series!;
    if (!seriesMap.has(series)) {
      seriesMap.set(series, []);
    }
    seriesMap.get(series)!.push(post);
  }

  return [...seriesMap.entries()].map(([slug, seriesPosts]) => ({
    params: { slug },
    props: {
      seriesPosts: seriesPosts.sort(
        (a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0),
      ),
    },
  }));
}

const { slug } = Astro.params;
const { seriesPosts } = Astro.props;
const title = slug!.replace(/-/g, ' ');
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={`Series: ${title}`}>
  <BackLink href="/series" label="All series" />

  <div class="mb-12">
    <div class="text-primary mb-2 font-mono text-xs tracking-widest uppercase">
      // Series · {String(seriesPosts.length).padStart(2, '0')} parts
    </div>
    <h1 class="text-foreground text-4xl font-extrabold tracking-tight capitalize">
      {title}
    </h1>
  </div>

  <div class="divide-border/0 divide-y">
    {
      seriesPosts.map((post) => (
        <article class="group hover:border-border hover:bg-surface/30 border-y border-transparent px-2 py-8 transition-colors">
          <div class="text-muted-foreground mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest uppercase">
            <span class="text-primary text-sm font-bold">
              {String(post.data.seriesOrder ?? 0).padStart(2, '0')}
            </span>
            <span class="text-primary">&bull;</span>
            <FormattedDate date={post.data.pubDate} />
          </div>
          <a href={`/blog/${post.id}`} class="block">
            <h2 class="text-foreground group-hover:text-primary mb-2 text-2xl font-bold transition-colors">
              {post.data.title}
            </h2>
          </a>
          {post.data.description && (
            <p class="text-muted-foreground mb-6 leading-relaxed">{post.data.description}</p>
          )}
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <TagBadge tag={tag} />
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>
