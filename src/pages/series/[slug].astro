---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

  const seriesMap = new Map<string, typeof posts>();
  for (const post of posts) {
    const series = post.data.series!;
    if (!seriesMap.has(series)) {
      seriesMap.set(series, []);
    }
    seriesMap.get(series)!.push(post);
  }

  return [...seriesMap.entries()].map(([slug, seriesPosts]) => ({
    params: { slug },
    props: {
      seriesPosts: seriesPosts.sort(
        (a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0),
      ),
    },
  }));
}

const { slug } = Astro.params;
const { seriesPosts } = Astro.props;
const title = slug!.replace(/-/g, ' ');
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={`Series: ${title}`}>
  <a
    href="/series"
    class="mb-8 inline-block font-mono text-xs tracking-widest text-(--color-muted-foreground) uppercase hover:text-(--color-primary)"
  >
    ← All series
  </a>

  <div class="mb-12">
    <div class="mb-2 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
      // Series · {String(seriesPosts.length).padStart(2, '0')} parts
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-(--color-foreground) capitalize">
      {title}
    </h1>
  </div>

  <div class="divide-y divide-(--color-border)/0">
    {
      seriesPosts.map((post) => (
        <article class="group border-y border-transparent px-2 py-8 transition-colors hover:border-(--color-border) hover:bg-(--color-surface)/30">
          <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest text-(--color-muted-foreground) uppercase">
            <span class="text-sm font-bold text-(--color-primary)">
              {String(post.data.seriesOrder ?? 0).padStart(2, '0')}
            </span>
            <span class="text-(--color-primary)">&bull;</span>
            <FormattedDate date={post.data.pubDate} />
          </div>
          <a href={`/blog/${post.id}`} class="block">
            <h2 class="mb-2 text-2xl font-bold text-(--color-foreground) transition-colors group-hover:text-(--color-primary)">
              {post.data.title}
            </h2>
          </a>
          {post.data.description && (
            <p class="mb-6 leading-relaxed text-(--color-muted-foreground)">
              {post.data.description}
            </p>
          )}
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="border border-(--color-border) bg-(--color-surface) px-2 py-1 font-mono text-[10px] text-(--color-muted-foreground)">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>
