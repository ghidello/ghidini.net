---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

// Group posts by series
const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  const series = post.data.series!;
  if (!seriesMap.has(series)) {
    seriesMap.set(series, []);
  }
  seriesMap.get(series)!.push(post);
}

// Sort each series by order
for (const [, seriesPosts] of seriesMap) {
  seriesPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}
---

<BaseLayout title={`Series - ${SITE_TITLE}`} description="Blog post series">
  <PageHeader
    label="// CONNECTED_THREADS"
    title="Series"
    description="Some topics are too big for one post. These are the multi-parters — ordered, indexed, and ready to binge."
  />

  {
    seriesMap.size === 0 ? (
      <p class="text-muted-foreground">No series yet. Check back soon!</p>
    ) : (
      <div class="divide-border/0 divide-y">
        {[...seriesMap.entries()].map(([seriesName, seriesPosts]) => (
          <article class="group hover:border-border hover:bg-surface/30 border-y border-transparent px-2 py-8 transition-colors">
            <div class="text-muted-foreground mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest uppercase">
              <span>
                Latest:{' '}
                {seriesPosts[seriesPosts.length - 1].data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
              <span class="text-primary">&bull;</span>
              <span>{String(seriesPosts.length).padStart(2, '0')} parts</span>
            </div>
            <a href={`/series/${seriesName}`} class="block">
              <h2 class="text-foreground group-hover:text-primary mb-2 text-2xl font-bold capitalize transition-colors">
                {seriesName.replace(/-/g, ' ')}
              </h2>
            </a>
            <p class="text-muted-foreground mb-6 leading-relaxed">
              Starts with {seriesPosts[0].data.title}
            </p>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
