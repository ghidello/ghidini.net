---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

// Group posts by series
const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  const series = post.data.series!;
  if (!seriesMap.has(series)) {
    seriesMap.set(series, []);
  }
  seriesMap.get(series)!.push(post);
}

// Sort each series by order
for (const [, seriesPosts] of seriesMap) {
  seriesPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}
---

<BaseLayout title={`Series - ${SITE_TITLE}`} description="Blog post series">
  <div class="mb-8 border-b border-(--color-border) pb-4">
    <h1 class="font-mono text-sm font-bold tracking-widest text-(--color-foreground) uppercase">
      Series Index
    </h1>
  </div>

  {
    seriesMap.size === 0 ? (
      <p class="text-(--color-muted-foreground)">No series yet. Check back soon!</p>
    ) : (
      <div class="space-y-10">
        {[...seriesMap.entries()].map(([seriesName, seriesPosts]) => (
          <section class="border border-(--color-border) bg-(--color-surface)/30 p-6">
            <div class="mb-4 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
              {seriesPosts.length} parts
            </div>
            <h2 class="mb-6 text-xl font-bold text-(--color-foreground) capitalize">
              {seriesName.replace(/-/g, ' ')}
            </h2>
            <ol class="space-y-2">
              {seriesPosts.map((post) => (
                <li class="flex gap-3 font-mono text-sm">
                  <span class="text-(--color-muted-foreground)">
                    {String(post.data.seriesOrder ?? 0).padStart(2, '0')}.
                  </span>
                  <a
                    href={`/blog/${post.id}`}
                    class="text-(--color-foreground) hover:text-(--color-primary)"
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
