---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

// Group posts by series
const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  const series = post.data.series!;
  if (!seriesMap.has(series)) {
    seriesMap.set(series, []);
  }
  seriesMap.get(series)!.push(post);
}

// Sort each series by order
for (const [, seriesPosts] of seriesMap) {
  seriesPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}
---

<BaseLayout title={`Series - ${SITE_TITLE}`} description="Blog post series">
  <div class="mb-12">
    <div class="mb-4 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
      // CONNECTED_THREADS
    </div>
    <h1 class="mb-4 text-5xl font-extrabold tracking-tight text-(--color-foreground)">Series</h1>
    <p class="max-w-2xl text-lg text-(--color-muted-foreground)">
      Some topics are too big for one post. These are the multi-parters — ordered, indexed, and
      ready to binge.
    </p>
  </div>

  {
    seriesMap.size === 0 ? (
      <p class="text-(--color-muted-foreground)">No series yet. Check back soon!</p>
    ) : (
      <div class="divide-y divide-(--color-border)/0">
        {[...seriesMap.entries()].map(([seriesName, seriesPosts]) => (
          <article class="group border-y border-transparent px-2 py-8 transition-colors hover:border-(--color-border) hover:bg-(--color-surface)/30">
            <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest text-(--color-muted-foreground) uppercase">
              <span>
                Latest:{' '}
                {seriesPosts[seriesPosts.length - 1].data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
              <span class="text-(--color-primary)">&bull;</span>
              <span>{String(seriesPosts.length).padStart(2, '0')} parts</span>
            </div>
            <a href={`/series/${seriesName}`} class="block">
              <h2 class="mb-2 text-2xl font-bold text-(--color-foreground) capitalize transition-colors group-hover:text-(--color-primary)">
                {seriesName.replace(/-/g, ' ')}
              </h2>
            </a>
            <p class="mb-6 leading-relaxed text-(--color-muted-foreground)">
              Starts with {seriesPosts[0].data.title}
            </p>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
