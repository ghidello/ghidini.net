---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

// Group posts by series
const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  const series = post.data.series!;
  if (!seriesMap.has(series)) {
    seriesMap.set(series, []);
  }
  seriesMap.get(series)!.push(post);
}

// Sort each series by order
for (const [, seriesPosts] of seriesMap) {
  seriesPosts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}
---

<BaseLayout title={`Series - ${SITE_TITLE}`} description="Blog post series">
  <div class="mb-8 border-b border-(--color-border) pb-4">
    <h1 class="font-mono text-sm font-bold tracking-widest text-(--color-foreground) uppercase">
      Series Index
    </h1>
  </div>

  {
    seriesMap.size === 0 ? (
      <p class="text-(--color-muted-foreground)">No series yet. Check back soon!</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2">
        {[...seriesMap.entries()].map(([seriesName, seriesPosts]) => (
          <a
            href={`/series/${seriesName}`}
            class="group border border-(--color-border) bg-(--color-surface)/30 p-6 transition-colors hover:border-(--color-primary)/50"
          >
            <div class="mb-2 font-mono text-xs tracking-widest text-(--color-primary) uppercase">
              // Series · {String(seriesPosts.length).padStart(2, '0')} parts
            </div>
            <h2 class="mb-3 text-xl font-bold text-(--color-foreground) capitalize group-hover:text-(--color-primary)">
              {seriesName.replace(/-/g, ' ')}
            </h2>
            <p class="text-sm text-(--color-muted-foreground)">
              Starts with {seriesPosts[0].data.title}
            </p>
            <div class="mt-4 flex items-center justify-between font-mono text-xs text-(--color-muted-foreground)">
              <span>
                Latest:{' '}
                {seriesPosts[seriesPosts.length - 1].data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  year: 'numeric',
                })}
              </span>
              <span class="text-(--color-primary)">READ →</span>
            </div>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
