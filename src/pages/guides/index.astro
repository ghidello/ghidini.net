---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by topic
const topicMap = new Map<string, typeof guides>();
for (const guide of guides) {
  const topic = guide.data.topic;
  if (!topicMap.has(topic)) {
    topicMap.set(topic, []);
  }
  topicMap.get(topic)!.push(guide);
}
---

<BaseLayout title={`Guides - ${SITE_TITLE}`} description="Quick reference guides and cheatsheets">
  <div class="mb-8 border-b border-(--color-border) pb-4">
    <h1 class="font-mono text-sm font-bold tracking-widest text-(--color-foreground) uppercase">
      Reference Manuals
    </h1>
    <p class="mt-2 text-sm text-(--color-muted-foreground)">
      Quick reference cheatsheets and commands I always forget.
    </p>
  </div>

  {
    topicMap.size === 0 ? (
      <p class="text-(--color-muted-foreground)">No guides yet. Check back soon!</p>
    ) : (
      <div class="space-y-10">
        {[...topicMap.entries()].map(([topic, topicGuides]) => (
          <section>
            <h2 class="mb-4 font-mono text-xs font-bold tracking-widest text-(--color-accent) uppercase">
              {topic}
            </h2>
            <div class="space-y-2">
              {topicGuides.map((guide) => (
                <a
                  href={`/guides/${guide.id}`}
                  class="group flex items-baseline justify-between border border-(--color-border) bg-(--color-surface)/30 p-4 transition-colors hover:border-(--color-primary)/40"
                >
                  <span class="font-medium text-(--color-foreground) transition-colors group-hover:text-(--color-primary)">
                    {guide.data.title}
                  </span>
                  <span class="ml-2 shrink-0 font-mono text-[10px] text-(--color-muted-foreground)">
                    <FormattedDate
                      date={guide.data.updatedDate ?? guide.data.pubDate}
                      format="month-year"
                    />
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
