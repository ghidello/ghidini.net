---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by topic
const topicMap = new Map<string, typeof guides>();
for (const guide of guides) {
  const topic = guide.data.topic;
  if (!topicMap.has(topic)) {
    topicMap.set(topic, []);
  }
  topicMap.get(topic)!.push(guide);
}
---

<BaseLayout title={`Guides - ${SITE_TITLE}`} description="Quick reference guides and cheatsheets">
  <h1 class="mb-2 text-3xl font-bold">Guides</h1>
  <p class="mb-8 text-(--color-text-secondary)">
    Quick reference cheatsheets and commands I always forget.
  </p>

  {
    topicMap.size === 0 ? (
      <p class="text-(--color-text-secondary)">No guides yet. Check back soon!</p>
    ) : (
      <div class="space-y-8">
        {[...topicMap.entries()].map(([topic, topicGuides]) => (
          <section>
            <h2 class="mb-3 text-lg font-semibold text-(--color-accent) capitalize">{topic}</h2>
            <ul class="space-y-2">
              {topicGuides.map((guide) => (
                <li>
                  <a
                    href={`/guides/${guide.id}`}
                    class="group -mx-3 flex items-baseline justify-between rounded-lg p-3 transition-colors hover:bg-(--color-bg-secondary)"
                  >
                    <span class="font-medium transition-colors group-hover:text-(--color-accent)">
                      {guide.data.title}
                    </span>
                    <span class="ml-2 shrink-0 text-xs text-(--color-text-secondary)">
                      <FormattedDate
                        date={guide.data.updatedDate ?? guide.data.pubDate}
                        format="month-year"
                      />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
