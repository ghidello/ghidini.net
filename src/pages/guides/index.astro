---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagBadge from '../../components/TagBadge.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { getSortedGuides } from '../../utils/collections';

const guides = await getSortedGuides();

// Group by topic
const topicMap = new Map<string, typeof guides>();
for (const guide of guides) {
  const topic = guide.data.topic;
  if (!topicMap.has(topic)) {
    topicMap.set(topic, []);
  }
  topicMap.get(topic)!.push(guide);
}
---

<BaseLayout title={`Guides - ${SITE_TITLE}`} description="Quick reference guides and cheatsheets">
  <PageHeader
    label="// REFERENCE_LIBRARY"
    title="Guides"
    description="Cheat sheets and quick references — for when the docs are too long and Stack Overflow is too noisy."
  />

  {
    topicMap.size === 0 ? (
      <p class="text-(--color-muted-foreground)">No guides yet. Check back soon!</p>
    ) : (
      <div class="divide-y divide-(--color-border)/0">
        {[...topicMap.entries()].map(([topic, topicGuides]) =>
          topicGuides.map((guide) => (
            <article class="group border-y border-transparent px-2 py-8 transition-colors hover:border-(--color-border) hover:bg-(--color-surface)/30">
              <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-widest text-(--color-muted-foreground) uppercase">
                <FormattedDate date={guide.data.updatedDate ?? guide.data.pubDate} />
                <span class="text-(--color-primary)">&bull;</span>
                <span>{topic}</span>
              </div>
              <a href={`/guides/${guide.id}`} class="block">
                <h2 class="mb-2 text-2xl font-bold text-(--color-foreground) transition-colors group-hover:text-(--color-primary)">
                  {guide.data.title}
                </h2>
              </a>
              <p class="mb-6 leading-relaxed text-(--color-muted-foreground)">
                {guide.data.description}
              </p>
              {guide.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {guide.data.tags.map((tag) => (
                    <TagBadge tag={tag} />
                  ))}
                </div>
              )}
            </article>
          )),
        )}
      </div>
    )
  }
</BaseLayout>
