---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import BackLink from '../../components/BackLink.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import Giscus from '../../components/Giscus.astro';
import { SITE_TITLE, SITE_URL, AUTHOR } from '../../consts';
import { isPublished, getReadingTime } from '../../utils/collections';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => isPublished(data));
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { title, description, pubDate, updatedDate, topic, author, tags } = guide.data;
const { Content } = await render(guide);

const readingTime = getReadingTime(guide.body);
const ogImage = `/open-graph/guides/${guide.id}.png`;
const canonical = new URL(`/guides/${guide.id}`, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: author, url: AUTHOR.url },
  publisher: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  keywords: tags.join(', '),
  image: new URL(ogImage, SITE_URL).href,
};
---

<BaseLayout
  title={`${title} - ${SITE_TITLE}`}
  description={description}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-4xl" data-pagefind-body>
    <BackLink href="/guides" label="All guides" />

    <header class="border-border mb-12 border-b pb-8">
      <div
        class="border-accent/30 bg-accent/5 text-accent mb-4 inline-block border px-3 py-1 font-mono text-[10px] tracking-widest uppercase"
      >
        {topic}
      </div>
      <h1
        class="text-foreground mb-4 text-4xl leading-tight font-extrabold tracking-tight md:text-5xl"
      >
        {title}
      </h1>
      <p class="text-muted-foreground mb-4 text-lg">{description}</p>
      <div class="text-muted-foreground flex flex-wrap items-center gap-4 font-mono text-xs">
        <FormattedDate date={pubDate} format="long" />
        <span>· By {author}</span>
        <span>· {readingTime} min read</span>
        {
          updatedDate && (
            <span>
              · Updated <FormattedDate date={updatedDate} format="long" />
            </span>
          )
        }
        {tags.map((t) => <span class="bg-surface ring-border px-2 py-0.5 ring-1">#{t}</span>)}
      </div>
    </header>

    <div class="prose-flux">
      <Content />
    </div>

    <Giscus />
  </article>
  <CodeCopy />
</BaseLayout>
