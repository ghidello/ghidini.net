---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { title, description, pubDate, updatedDate, topic, author, tags } = guide.data;
const { Content } = await render(guide);
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description}>
  <article class="mx-auto max-w-4xl">
    <BackLink href="/guides" label="All guides" />

    <header class="mb-12 border-b border-(--color-border) pb-8">
      <div
        class="mb-4 inline-block border border-(--color-accent)/30 bg-(--color-accent)/5 px-3 py-1 font-mono text-[10px] tracking-widest text-(--color-accent) uppercase"
      >
        {topic}
      </div>
      <h1
        class="mb-4 text-4xl leading-tight font-extrabold tracking-tight text-(--color-foreground) md:text-5xl"
      >
        {title}
      </h1>
      <p class="mb-4 text-lg text-(--color-muted-foreground)">{description}</p>
      <div
        class="flex flex-wrap items-center gap-4 font-mono text-xs text-(--color-muted-foreground)"
      >
        <FormattedDate date={pubDate} format="long" />
        <span>· By {author}</span>
        {
          updatedDate && (
            <span>
              · Updated <FormattedDate date={updatedDate} format="long" />
            </span>
          )
        }
        {
          tags.map((t) => (
            <span class="bg-(--color-surface) px-2 py-0.5 ring-1 ring-(--color-border)">#{t}</span>
          ))
        }
      </div>
    </header>

    <div class="prose-flux">
      <Content />
    </div>
  </article>
</BaseLayout>
