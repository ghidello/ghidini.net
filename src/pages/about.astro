---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_TITLE, SITE_URL, AUTHOR, SITE_DESCRIPTION } from '../consts';

// NOTE: This bio is drafted from the blog's context. Replace the prose below
// with the exact summary from your LinkedIn profile when you get a chance.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: SITE_URL,
    jobTitle: 'Software Developer',
    description: SITE_DESCRIPTION,
    sameAs: AUTHOR.sameAs,
  },
};

const stack = [
  '.NET / C#',
  'SQL Server',
  'TypeScript',
  'Astro',
  'Cloudflare Workers',
  'AI-assisted dev',
  'Software architecture',
];
---

<BaseLayout
  title={`About - ${SITE_TITLE}`}
  description="Alessandro Ghidini — software developer. Who I am and what this blog is for."
  jsonLd={jsonLd}
>
  <PageHeader
    label="// WHO_IS_THIS"
    title="About"
    description="The human behind the flux capacitor."
  />

  <div class="grid gap-12 lg:grid-cols-12">
    <div class="prose-flux lg:col-span-8">
      <p>
        I'm <strong>Alessandro Ghidini</strong>, a software developer with more than 20 years of
        experience building enterprise applications and solving complex technical challenges.
      </p>
      <p>
        This blog is where I share practical insights, lessons learned, and experiments involving
        <strong>.NET</strong>, <strong>C#</strong>, <strong>SQL Server</strong>, cloud technologies,
        AI-assisted development, software architecture, and whatever else happens to capture my
        curiosity.
      </p>
      <p>
        My goal is simple: document what I learn, share solutions to real-world problems, and create
        a place where I can find them again when my notoriously bad memory inevitably lets me down.
        If these notes happen to help other developers as well, that's a welcome bonus.
      </p>
      <p>
        When I'm not writing code, I'm probably out walking through the countryside near my home,
        listening to audiobooks of adventure novels and letting my mind wander toward the next
        project or idea.
      </p>
    </div>

    <aside class="space-y-8 lg:col-span-4">
      <section class="border-border bg-surface/30 border p-6">
        <h2 class="text-foreground mb-4 font-mono text-xs font-bold tracking-widest uppercase">
          Stack
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            stack.map((item) => (
              <span class="border-border bg-surface text-muted-foreground border px-2 py-1 font-mono text-[10px] tracking-widest uppercase">
                {item}
              </span>
            ))
          }
        </div>
      </section>

      <section class="border-border bg-surface/30 border p-6">
        <h2 class="text-foreground mb-4 font-mono text-xs font-bold tracking-widest uppercase">
          Elsewhere
        </h2>
        <div class="flex flex-col gap-3 font-mono text-sm">
          <a
            href="https://github.com/ghidello"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            GitHub &rarr;
          </a>
          <a
            href="https://www.linkedin.com/in/alessandroghidini/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            LinkedIn &rarr;
          </a>
          <a
            href="https://x.com/ghidello"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            X / Twitter &rarr;
          </a>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
